{
  "schemaVersion": 1,
  "id": "aaditya.spotify",
  "name": "Spotify",
  "version": "1.0.0",
  "author": "aaditya",
  "description": "Spotify now-playing with inline playback controls",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Spotify",
    "description": "Spotify now-playing with inline playback controls",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showControls": false,
      "showLabel": false,
      "maxLabelWidth": 220
    }
  }
}
